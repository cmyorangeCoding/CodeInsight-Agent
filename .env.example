# =====================================================
# CodeInsight-Agent 环境变量模板
# 复制此文件为 .env 后填入实际值
# .env 已被 .gitignore 覆盖，请勿提交
# =====================================================

# --- DashScope / 阿里通义大模型 ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=
SUMMARIZATION_MODEL=qwen-flash
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# --- PostgreSQL + pgvector ---
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/codeinsight?sslmode=disable

# --- 默认仓库（CLI 模式）---
DEFAULT_REPO_PATH=E:\GiteePro\CodeInsight-Agent
DEFAULT_REPOSITORY_ID=CodeInsight-Agent

# --- GitHub MCP（可选，不填只能读公开仓库）---
GITHUB_TOKEN=
GITHUB_MCP_TRANSPORT=stdio
GITHUB_MCP_COMMAND=
GITHUB_MCP_ARGS=
GITHUB_MCP_TIMEOUT=30
GITHUB_MCP_TOOL_TIMEOUT=60
GITHUB_MCP_ALLOWED_TOOLS=

# --- FastAPI 服务 ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
CORS_ORIGINS=*
TASK_TIMEOUT=300
MAX_CONCURRENT_TASKS=5
CODEINSIGHT_CLONE_WORKSPACE=
CLONE_CLEANUP_THRESHOLD_MB=500
